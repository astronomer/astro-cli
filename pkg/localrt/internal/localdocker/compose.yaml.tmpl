x-common-env: &common-env
{{- range .Env}}
  {{.Name}}: {{.Value}}
{{- end}}
{{- range .PassEnv}}
  {{quote .}}:
{{- end}}

networks:
  airflow:
    driver: bridge

volumes:
  postgres_data:
    driver: local
{{- with .SecretEnv}}
  # The secret handoff's file lives here, in memory only. See secretEnvSpec in
  # compose.go: env set in this file would put the values in each container's
  # configuration, which the daemon keeps on disk.
  {{.Volume}}:
    driver: local
    driver_opts:
      type: tmpfs
      device: tmpfs
      o: "size=4m,mode=1777"
{{- end}}

services:
  postgres:
    image: {{.PostgresImage}}
    restart: unless-stopped
    networks:
      - airflow
    labels:
      io.astronomer.docker: "true"
      io.astronomer.docker.cli: "true"
    ports:
      - 127.0.0.1:{{.PostgresPort}}:5432
    volumes:
      - postgres_data:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    # What the migration waits on, so compose itself reports a database that
    # never comes up ("dependency failed to start") rather than the up waiting
    # on it forever. Over TCP on purpose: the image's first-run init serves a
    # temporary server on the unix socket only, and a check that accepted it
    # would start the migration against a server about to shut down.
    # start_period is generous so a cold init or a slow crash recovery is not
    # called dead; a container that exits fails the up within seconds anyway.
    # Podman runs healthchecks through systemd, which docs/install.md notes.
    healthcheck:
      test: ["CMD", "pg_isready", "--host", "localhost", "--username", "postgres"]
      interval: 2s
      timeout: 5s
      retries: 5
      start_period: 10m
{{- with .SecretEnv}}

  # Holds the handoff volume mounted, so its contents outlive any one Airflow
  # container's restart, and reports healthy once the start has written the
  # file. Does nothing else: no network, no command of its own.
  {{.Service}}:
    image: {{$.Image}}
    entrypoint: ["sleep", "infinity"]
    init: true
    restart: unless-stopped
    network_mode: none
    user: astro
    labels:
      io.astronomer.docker: "true"
      io.astronomer.docker.cli: "true"
      io.astronomer.docker.component: "airflow-{{.Service}}"
    volumes:
      - {{.Volume}}:{{.Dir}}
    healthcheck:
      test: ["CMD", "test", "-s", "{{.File}}"]
      interval: 1s
      timeout: 5s
      retries: 3
      start_period: 1m
{{- end}}

  db-migration:
    depends_on:
      postgres:
        condition: service_healthy
{{- template "secretdep" $}}
    image: {{.Image}}
    command:
{{- range .DBCommand}}
      - {{quote .}}
{{- end}}
    networks:
      - airflow
    labels:
      io.astronomer.docker: "true"
      io.astronomer.docker.cli: "true"
      io.astronomer.docker.component: "airflow-db-migration"
    environment: *common-env
{{- with .SecretEnv}}
    volumes:
      - {{.Volume}}:{{.Dir}}:ro
{{- end}}
{{- range .Services}}

  {{.Name}}:
    # Wait for the migration to finish, not just to start: a component that
    # opens the metadata database before the tables exist crash-loops, and
    # Astro Runtime's version-check plugin creates its own table on every
    # start, which collides when several components do it at once.
    depends_on:
      db-migration:
        condition: service_completed_successfully
{{- template "secretdep" $}}
    image: {{$.Image}}
    command:
{{- range .Command}}
      - {{quote .}}
{{- end}}
    restart: unless-stopped
    networks:
      - airflow
    user: astro
    labels:
      io.astronomer.docker: "true"
      io.astronomer.docker.cli: "true"
      io.astronomer.docker.component: "airflow-{{.Name}}"
    environment: *common-env
{{- if .Publish}}
    ports:
      - 127.0.0.1:{{$.WebPort}}:8080
{{- end}}
{{- template "mounts" $}}
{{- end}}

{{- define "mounts"}}
{{- if or .Mounts .SecretEnv}}
    volumes:
{{- range .Mounts}}
      - {{.Host}}:{{.Container}}:z
{{- end}}
{{- with .SecretEnv}}
      - {{.Volume}}:{{.Dir}}:ro
{{- end}}
{{- end}}
{{- end}}

{{- define "secretdep"}}
{{- with .SecretEnv}}
      {{.Service}}:
        condition: service_healthy
{{- end}}
{{- end}}
