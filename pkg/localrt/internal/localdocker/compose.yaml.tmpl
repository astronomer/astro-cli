x-common-env: &common-env
{{- range .Env}}
  {{.Name}}: {{.Value}}
{{- end}}
{{- range .PassEnv}}
  {{quote .}}:
{{- end}}

networks:
  airflow:
    driver: bridge

volumes:
  postgres_data:
    driver: local

services:
  postgres:
    image: {{.PostgresImage}}
    restart: unless-stopped
    networks:
      - airflow
    labels:
      io.astronomer.docker: "true"
      io.astronomer.docker.cli: "true"
    ports:
      - 127.0.0.1:{{.PostgresPort}}:5432
    volumes:
      - postgres_data:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres

  db-migration:
    depends_on:
      - postgres
    image: {{.Image}}
    command:
{{- range .DBCommand}}
      - {{quote .}}
{{- end}}
    networks:
      - airflow
    labels:
      io.astronomer.docker: "true"
      io.astronomer.docker.cli: "true"
      io.astronomer.docker.component: "airflow-db-migration"
    environment: *common-env
{{- range .Services}}

  {{.Name}}:
    # Wait for the migration to finish, not just to start: a component that
    # opens the metadata database before the tables exist crash-loops, and
    # Astro Runtime's version-check plugin creates its own table on every
    # start, which collides when several components do it at once.
    depends_on:
      db-migration:
        condition: service_completed_successfully
    image: {{$.Image}}
    command:
{{- range .Command}}
      - {{quote .}}
{{- end}}
    restart: unless-stopped
    networks:
      - airflow
    user: astro
    labels:
      io.astronomer.docker: "true"
      io.astronomer.docker.cli: "true"
      io.astronomer.docker.component: "airflow-{{.Name}}"
    environment: *common-env
{{- if .Publish}}
    ports:
      - 127.0.0.1:{{$.WebPort}}:8080
{{- end}}
{{- template "mounts" $}}
{{- end}}

{{- define "mounts"}}
{{- if .Mounts}}
    volumes:
{{- range .Mounts}}
      - {{.Host}}:{{.Container}}:z
{{- end}}
{{- end}}
{{- end}}
